# OCR engine used for all requests.
# Options: surya | auto | easyocr | tesseract | paddle
DEFAULT_OCR_ENGINE=surya

# Surya recognition model numeric precision.
# float32 — full precision; better accuracy, 2x GPU memory, ~30% slower.
# float16 — Surya default on GPU; faster, less memory, slight accuracy drop.
# On CPU Surya always runs float32 regardless of this setting.
SURYA_DTYPE=float16
MAX_LONG_SIDE=2800
SURYA_RECOGNITION_BATCH_SIZE=64
SURYA_DETECTOR_BATCH_SIZE=16
OCR_MAX_CONCURRENCY=2
OCR_QUEUE_WAIT_SECONDS=5
OCR_WARMUP_ENABLED=true

# Leave empty unless you have IndicNLP resources installed separately.
INDIC_RESOURCES_PATH=

# MySQL — stores upload history (image + extracted fields) shown on /uploads.
# On GCP, point these at your Cloud SQL instance (or the Cloud SQL Auth Proxy on 127.0.0.1).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nid_ocr
